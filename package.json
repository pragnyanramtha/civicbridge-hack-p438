{
  "name": "civicbridge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env.local scripts/smoke.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.0.0",
    "@vercel/oidc": "^4.0.5",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
